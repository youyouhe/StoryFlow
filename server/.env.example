# Gallery backend configuration — copy to .env (never commit .env)

# Listen port
PORT=8787

# PostgreSQL connection string
# Local dev example:  postgres://bird@127.0.0.1:5433/storyflow_dev
# Production example: postgres://storyflow:<password>@127.0.0.1:5432/storyflow
DATABASE_URL=postgres://bird@127.0.0.1:5433/storyflow_dev

# HS256 secret for access-token JWTs. REQUIRED IN PRODUCTION.
# Generate: openssl rand -hex 32
# (If unset the server boots with a random per-boot secret + loud warning —
# every restart invalidates all sessions.)
# JWT_SECRET=

# Comma-separated allowed browser origins (CORS)
CORS_ORIGIN=http://localhost:5173

# Refresh-token lifetime, days
REFRESH_TTL_DAYS=90
